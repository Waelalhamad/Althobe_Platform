{
  "name": "althobe",
  "private": true,
  "type": "module",
  "description": "Al Thob Al Arabi — business platform (modular monolith)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @althobe/backend --filter @althobe/warehouse dev",
    "dev:practice": "pnpm --parallel --filter @althobe/backend --filter @althobe/warehouse dev:practice",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "db:migrate": "pnpm --filter @althobe/backend db:migrate",
    "db:migration:new": "pnpm --filter @althobe/backend db:migration:new",
    "db:seed": "pnpm --filter @althobe/backend db:seed"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
