# Copy to backend/.env and fill in from the Neon console. Never commit real values.
# Neon → your project → Connection Details. Region: AWS eu-central-1 (Frankfurt).
# The app connects over port 443 (WebSocket), so a network that blocks 5432 is fine (ADR-006).

# Runtime: the POOLED connection string (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/althobe?sslmode=require&pgbouncer=true&connect_timeout=15"

# Migrations: the DIRECT connection string (same host without "-pooler").
# Schema changes cannot run through the pooler.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/althobe?sslmode=require&connect_timeout=15"

# Tests: a SEPARATE database (e.g. althobe_test on the same endpoint) or a separate Neon branch.
# The suite wipes every table in it, and refuses to run if it is the same database as either URL above.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/althobe_test?sslmode=require&connect_timeout=15"

# Base currency for stock valuation (ADR-004)
BASE_CURRENCY="SYP"

# ── Production (Railway → service → Variables; never in a file or in git) — ADR-007 ──────────
# DATABASE_URL and DIRECT_URL as above (the real database), plus:
# NODE_ENV="production"     # secure cookies, listen on 0.0.0.0
# PORT is set by Railway.
# Product photos (S3, used from the product-details feature on):
# AWS_REGION="eu-central-1"
# S3_BUCKET="althobe-product-images"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
