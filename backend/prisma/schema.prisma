// Al Thob Al Arabi — database schema.
// Conventions: docs/database.md. Inventory rules: docs/inventory.md.
// Rules Prisma cannot express (check constraints, the barcode sequence, append-only triggers)
// live in raw SQL at the end of the migrations. Never edit an applied migration.

generator client {
  provider = "prisma-client-js"
}

// Neon (ADR-006): the app connects through the pooler; migrations need the direct connection.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────────────────────────────

enum UnitOfMeasure {
  PIECE
  BOX
  METER
  KG

  @@map("unit_of_measure")
}

enum LocationKind {
  WAREHOUSE
  STORE

  @@map("location_kind")
}

enum MovementType {
  OPENING
  PURCHASE
  SALE
  RETURN
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  DAMAGE
  STOCKTAKE

  @@map("movement_type")
}

enum ReferenceType {
  OPENING
  SCAN_SESSION
  STOCKTAKE
  MANUAL
  TRANSFER
  GOODS_RECEIPT
  PURCHASE_ORDER
  SALES_ORDER
  RETURN

  @@map("reference_type")
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED

  @@map("reservation_status")
}

enum ScanSessionKind {
  OPENING
  RECEIVE
  TRANSFER
  DAMAGE
  SALE
  RETURN

  @@map("scan_session_kind")
}

enum ScanSessionStatus {
  OPEN
  COMMITTED
  CANCELLED

  @@map("scan_session_status")
}

enum StocktakeScope {
  FULL
  PARTIAL

  @@map("stocktake_scope")
}

enum StocktakeStatus {
  DRAFT
  COUNTING
  REVIEW
  APPLIED
  CANCELLED

  @@map("stocktake_status")
}

// Which price of a product or size (ADR-012), each list in one currency: retail in SYP (Syria)
// and LYD (Libya), wholesale in USD. Customer price tiers become more lists.
enum PriceList {
  RETAIL_SYP
  RETAIL_LYD
  WHOLESALE

  @@map("price_list")
}

enum ExternalBarcodeKind {
  GTIN
  SUPPLIER

  @@map("external_barcode_kind")
}

// ─── Platform ──────────────────────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @unique(map: "uq_users_email")
  nameAr       String    @map("name_ar")
  nameEn       String?   @map("name_en")
  isActive     Boolean   @default(true) @map("is_active")
  // argon2id. Null for machine users (e.g. "system"), which can never log in.
  passwordHash String?   @map("password_hash")
  // Role names from src/modules/auth/roles.ts. Code checks permissions, never these names.
  roles        String[]  @default([])
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions Session[]

  movements           InventoryMovement[]
  reservations        Reservation[]
  scanSessions        ScanSession[]        @relation("ScanSessionCreatedBy")
  scanSessionsClosed  ScanSession[]        @relation("ScanSessionCommittedBy")
  scanEvents          ScanSessionEvent[]
  stocktakesCreated   Stocktake[]          @relation("StocktakeCreatedBy")
  stocktakesApplied   Stocktake[]          @relation("StocktakeAppliedBy")
  stocktakeEvents     StocktakeScanEvent[]
  auditLogs           AuditLog[]
  productPhotos       ProductPhoto[]
  exchangeRates       ExchangeRate[]
  journalEntries      JournalEntry[]
  periodsClosed       AccountingPeriod[]
  shiftsOpened        PosShift[]           @relation("PosShiftOpenedBy")
  shiftsClosed        PosShift[]           @relation("PosShiftClosedBy")
  posSales            PosSale[]
  payrollRunsCreated  PayrollRun[]         @relation("PayrollRunCreatedBy")
  payrollRunsApproved PayrollRun[]         @relation("PayrollRunApprovedBy")
  payrollPayments     PayrollPayment[]
  employeeAdvances    EmployeeAdvance[]
  partyEntries        PartyEntry[]

  @@map("users")
}

// ADR-012: the owner's exchange rates, units of the currency per 1 USD (USD is the base). One row
// per currency; each change is in the audit log. A cost stamps the rate it used, so changing a
// rate never changes a past record.
model ExchangeRate {
  currency     String   @id @db.Char(3)
  rate         Decimal  @db.Decimal(18, 6)
  // The central bank's rate, for reference only; postings use `rate` (ADR-013).
  officialRate Decimal? @map("official_rate") @db.Decimal(18, 6)
  updatedBy    String   @map("updated_by") @db.Uuid
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  updater User @relation(fields: [updatedBy], references: [id])

  @@map("exchange_rates")
}

// Server-side sessions (docs/security.md): the cookie holds a random token; only its SHA-256 is
// stored, so a database leak does not leak live sessions. Revocation is instant.
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique(map: "uq_sessions_token_hash") @map("token_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  ip         String?
  userAgent  String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "idx_sessions_user_id")
  @@map("sessions")
}

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId], map: "idx_audit_logs_entity")
  @@index([actorId, createdAt(sort: Desc)], map: "idx_audit_logs_actor_created")
  @@map("audit_logs")
}

model IdempotencyRecord {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String
  operation   String
  requestHash String   @map("request_hash")
  response    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@unique([key, operation], map: "uq_idempotency_records_key_operation")
  @@index([expiresAt], map: "idx_idempotency_records_expires_at")
  @@map("idempotency_records")
}

// ─── Catalogue ─────────────────────────────────────────────────────────────────────────────────

// A category (ADR-011): ثوب، طقم … in a tree up to three levels deep. It names the option types
// its products are made with. Its code starts SKUs (THB-…).
model Category {
  id            String        @id @default(uuid(7)) @db.Uuid
  code          String        @unique(map: "uq_categories_code")
  nameAr        String        @map("name_ar")
  nameEn        String?       @map("name_en")
  parentId      String?       @map("parent_id") @db.Uuid
  sortOrder     Int           @default(0) @map("sort_order")
  unitOfMeasure UnitOfMeasure @default(PIECE) @map("unit_of_measure")
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz(3)

  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]            @relation("CategoryTree")
  products     Product[]
  optionGroups CategoryOptionGroup[]

  @@index([parentId], map: "idx_categories_parent_id")
  @@map("categories")
}

// A product (ADR-011): one design in a category, with one value of each option type except the
// size. Its sizes are its variants. The code is the SKU base (THB-SA-RY-…-WH).
model Product {
  id         String    @id @default(uuid(7)) @db.Uuid
  categoryId String    @map("category_id") @db.Uuid
  code       String    @unique(map: "uq_products_code")
  // The chosen non-size value ids, sorted and comma-joined: one product per design per category.
  styleKey   String    @map("style_key")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  category    Category            @relation(fields: [categoryId], references: [id])
  styleValues ProductStyleValue[]
  variants    ProductVariant[]
  prices      ProductPrice[]
  photos      ProductPhoto[]

  @@unique([categoryId, styleKey], map: "uq_products_category_style")
  @@map("products")
}

// Configurable variant options (ADR-008): an option type (القصة، الزر، القماش، اللون، القياس…) and
// its values are data the owner edits, not columns. Deactivated, never deleted.
model OptionGroup {
  id        String    @id @default(uuid(7)) @db.Uuid
  // Stable key for the built-in types (SIZE is printed large on labels); null for added types.
  key       String?   @unique(map: "uq_option_groups_key")
  // Unique among types not deleted (partial index in the migration).
  nameAr    String    @unique(map: "uq_option_groups_name_ar") @map("name_ar")
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  // Deleted: gone from every list; products deleted earlier keep pointing at it.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  values        OptionValue[]
  categories    CategoryOptionGroup[]
  styleValues   ProductStyleValue[]
  variantValues VariantOptionValue[]

  @@map("option_groups")
}

model OptionValue {
  id        String    @id @default(uuid(7)) @db.Uuid
  groupId   String    @map("group_id") @db.Uuid
  // A detail of another value of the same type (جوخ هندي → مشخط); null at the top. Up to 3 levels.
  parentId  String?   @map("parent_id") @db.Uuid
  valueAr   String    @map("value_ar")
  // Short Latin code the SKU is built from (سعودية → SA); unique among its siblings.
  code      String
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  group         OptionGroup          @relation(fields: [groupId], references: [id])
  // Composite: a detail always sits under a value of its own type.
  parent        OptionValue?         @relation("OptionValueDetails", fields: [parentId, groupId], references: [id, groupId])
  details       OptionValue[]        @relation("OptionValueDetails")
  styleValues   ProductStyleValue[]
  variantValues VariantOptionValue[]

  // NULLS NOT DISTINCT and only among values not deleted (migration): two top-level values may
  // not share a name or code.
  @@unique([groupId, parentId, valueAr], map: "uq_option_values_group_parent_value")
  @@unique([groupId, parentId, code], map: "uq_option_values_group_parent_code")
  // Target of the composite foreign keys that keep a value under the right type.
  @@unique([id, groupId], map: "uq_option_values_id_group")
  @@index([parentId], map: "idx_option_values_parent_id")
  @@map("option_values")
}

// Which option types a category's products are made with.
model CategoryOptionGroup {
  categoryId String @map("category_id") @db.Uuid
  groupId    String @map("group_id") @db.Uuid

  category Category    @relation(fields: [categoryId], references: [id])
  group    OptionGroup @relation(fields: [groupId], references: [id])

  @@id([categoryId, groupId])
  @@index([groupId], map: "idx_category_option_groups_group_id")
  @@map("category_option_groups")
}

// A product's design: one value per non-size option type.
model ProductStyleValue {
  productId String @map("product_id") @db.Uuid
  groupId   String @map("group_id") @db.Uuid
  valueId   String @map("value_id") @db.Uuid

  product Product     @relation(fields: [productId], references: [id])
  group   OptionGroup @relation(fields: [groupId], references: [id])
  value   OptionValue @relation(fields: [valueId, groupId], references: [id, groupId])

  @@id([productId, groupId])
  @@index([valueId], map: "idx_product_style_values_value_id")
  @@map("product_style_values")
}

// A variant's size (the only option held on the variant itself since ADR-011).
model VariantOptionValue {
  variantId String @map("variant_id") @db.Uuid
  groupId   String @map("group_id") @db.Uuid
  valueId   String @map("value_id") @db.Uuid

  variant ProductVariant @relation(fields: [variantId], references: [id])
  group   OptionGroup    @relation(fields: [groupId], references: [id])
  value   OptionValue    @relation(fields: [valueId, groupId], references: [id, groupId])

  @@id([variantId, groupId])
  @@index([valueId], map: "idx_variant_option_values_value_id")
  @@map("variant_option_values")
}

// One size of a product: its own barcode, SKU and stock.
model ProductVariant {
  id        String    @id @default(uuid(7)) @db.Uuid
  productId String    @map("product_id") @db.Uuid
  sku       String    @unique(map: "uq_product_variants_sku")
  barcode   String    @unique(map: "uq_product_variants_barcode") @db.Char(13)
  // The size value id ('' for a category without sizes): one variant per size per product.
  optionKey String    @map("option_key")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  product          Product              @relation(fields: [productId], references: [id])
  optionValues     VariantOptionValue[]
  prices           VariantPrice[]
  externalBarcodes VariantBarcode[]
  balances         InventoryBalance[]
  movements        InventoryMovement[]
  reservations     Reservation[]
  scanLines        ScanSessionLine[]
  scanEvents       ScanSessionEvent[]
  stocktakeLines   StocktakeLine[]
  stocktakeEvents  StocktakeScanEvent[]
  posSaleLines     PosSaleLine[]

  @@unique([productId, optionKey], map: "uq_product_variants_option_key")
  @@index([productId], map: "idx_product_variants_product_id")
  @@map("product_variants")
}

// A product's selling price on one list (ADR-009), for all its sizes.
model ProductPrice {
  id        String    @id @default(uuid(7)) @db.Uuid
  productId String    @map("product_id") @db.Uuid
  list      PriceList
  amount    BigInt
  currency  String    @db.Char(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, list], map: "uq_product_prices_product_list")
  @@map("product_prices")
}

// A price for one size that differs from its product's (e.g. size 64 costs more).
model VariantPrice {
  id        String    @id @default(uuid(7)) @db.Uuid
  variantId String    @map("variant_id") @db.Uuid
  list      PriceList
  amount    BigInt
  currency  String    @db.Char(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([variantId, list], map: "uq_variant_prices_variant_list")
  @@map("variant_prices")
}

// A product photo in S3 (ADR-010): a full image and a thumbnail. The first is the product's main
// photo. Soft-deleted; the S3 objects are removed when the photo is deleted.
model ProductPhoto {
  id          String    @id @default(uuid(7)) @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  imageKey    String    @map("image_key")
  thumbKey    String    @map("thumb_key")
  contentType String    @map("content_type")
  byteSize    Int       @map("byte_size")
  width       Int
  height      Int
  sortOrder   Int       @default(0) @map("sort_order")
  createdById String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  product   Product @relation(fields: [productId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([productId], map: "idx_product_photos_product_id")
  @@map("product_photos")
}

// Barcodes that arrive printed on goods: manufacturer GTINs and supplier codes.
model VariantBarcode {
  id        String              @id @default(uuid(7)) @db.Uuid
  variantId String              @map("variant_id") @db.Uuid
  barcode   String              @unique(map: "uq_variant_barcodes_barcode")
  kind      ExternalBarcodeKind
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([variantId], map: "idx_variant_barcodes_variant_id")
  @@map("variant_barcodes")
}

// ─── Locations ─────────────────────────────────────────────────────────────────────────────────

model Location {
  id        String       @id @default(uuid(7)) @db.Uuid
  code      String       @unique(map: "uq_locations_code")
  nameAr    String       @map("name_ar")
  nameEn    String?      @map("name_en")
  kind      LocationKind
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  balances         InventoryBalance[]
  movements        InventoryMovement[]
  reservations     Reservation[]
  scanSessionsFrom ScanSession[]       @relation("ScanSessionLocation")
  scanSessionsTo   ScanSession[]       @relation("ScanSessionToLocation")
  stocktakes       Stocktake[]
  glAccount        GlAccount?
  journalLines     JournalLine[]
  posShifts        PosShift[]
  posSales         PosSale[]

  @@map("locations")
}

// ─── Inventory ledger ──────────────────────────────────────────────────────────────────────────

// Derived, cached current state. Written only by InventoryService, in the same transaction as the
// movements that change it. value_base_amount is the total stock value in USD cents (ADR-012); the
// average unit cost is derived (value / quantity) so repeated averaging never accumulates
// rounding error.
model InventoryBalance {
  id               String   @id @default(uuid(7)) @db.Uuid
  variantId        String   @map("variant_id") @db.Uuid
  locationId       String   @map("location_id") @db.Uuid
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  valueBaseAmount  BigInt   @default(0) @map("value_base_amount")
  version          Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant  ProductVariant @relation(fields: [variantId], references: [id])
  location Location       @relation(fields: [locationId], references: [id])

  @@unique([variantId, locationId], map: "uq_inventory_balances_variant_location")
  @@index([locationId], map: "idx_inventory_balances_location_id")
  @@map("inventory_balances")
}

// The ledger. Append-only: a trigger rejects UPDATE and DELETE.
// seq gives a total order of the ledger, used by stocktake snapshots.
model InventoryMovement {
  id                 String        @id @default(uuid(7)) @db.Uuid
  seq                BigInt        @unique(map: "uq_inventory_movements_seq") @default(autoincrement())
  variantId          String        @map("variant_id") @db.Uuid
  locationId         String        @map("location_id") @db.Uuid
  type               MovementType
  quantity           Int
  balanceAfter       Int           @map("balance_after")
  referenceType      ReferenceType @map("reference_type")
  referenceId        String?       @map("reference_id") @db.Uuid
  transferId         String?       @map("transfer_id") @db.Uuid
  reason             String?
  note               String?
  unitCostAmount     BigInt?       @map("unit_cost_amount")
  unitCostCurrency   String?       @map("unit_cost_currency") @db.Char(3)
  // Units of the cost's currency per 1 USD, the base (ADR-012); 1 for USD.
  rateToBase         Decimal?      @map("rate_to_base") @db.Decimal(18, 6)
  unitCostBaseAmount BigInt        @map("unit_cost_base_amount")
  valueBaseAmount    BigInt        @map("value_base_amount")
  createdById        String        @map("created_by") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  idempotencyKey     String?       @map("idempotency_key")

  variant   ProductVariant @relation(fields: [variantId], references: [id])
  location  Location       @relation(fields: [locationId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])

  @@index([variantId, locationId, seq(sort: Desc)], map: "idx_inventory_movements_variant_location_seq")
  @@index([locationId, seq], map: "idx_inventory_movements_location_seq")
  @@index([referenceType, referenceId], map: "idx_inventory_movements_reference")
  @@index([transferId], map: "idx_inventory_movements_transfer_id")
  @@map("inventory_movements")
}

model Reservation {
  id          String            @id @default(uuid(7)) @db.Uuid
  variantId   String            @map("variant_id") @db.Uuid
  locationId  String            @map("location_id") @db.Uuid
  orderId     String            @map("order_id") @db.Uuid
  quantity    Int
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime?         @map("expires_at") @db.Timestamptz(3)
  releasedAt  DateTime?         @map("released_at") @db.Timestamptz(3)
  createdById String            @map("created_by") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant   ProductVariant @relation(fields: [variantId], references: [id])
  location  Location       @relation(fields: [locationId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])

  @@index([variantId, locationId, status], map: "idx_reservations_variant_location_status")
  @@index([orderId], map: "idx_reservations_order_id")
  @@map("reservations")
}

// ─── Scan sessions (drafts built by scanning; touch the ledger only on commit) ────────────────

model ScanSession {
  id            String            @id @default(uuid(7)) @db.Uuid
  kind          ScanSessionKind
  status        ScanSessionStatus @default(OPEN)
  locationId    String            @map("location_id") @db.Uuid
  toLocationId  String?           @map("to_location_id") @db.Uuid
  reason        String?
  note          String?
  createdById   String            @map("created_by") @db.Uuid
  committedById String?           @map("committed_by") @db.Uuid
  committedAt   DateTime?         @map("committed_at") @db.Timestamptz(3)
  cancelledAt   DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  location    Location  @relation("ScanSessionLocation", fields: [locationId], references: [id])
  toLocation  Location? @relation("ScanSessionToLocation", fields: [toLocationId], references: [id])
  createdBy   User      @relation("ScanSessionCreatedBy", fields: [createdById], references: [id])
  committedBy User?     @relation("ScanSessionCommittedBy", fields: [committedById], references: [id])

  lines  ScanSessionLine[]
  events ScanSessionEvent[]

  @@index([status, locationId], map: "idx_scan_sessions_status_location")
  @@map("scan_sessions")
}

model ScanSessionLine {
  id               String   @id @default(uuid(7)) @db.Uuid
  sessionId        String   @map("session_id") @db.Uuid
  variantId        String   @map("variant_id") @db.Uuid
  quantity         Int      @default(0)
  unitCostAmount   BigInt?  @map("unit_cost_amount")
  unitCostCurrency String?  @map("unit_cost_currency") @db.Char(3)
  rateToBase       Decimal? @map("rate_to_base") @db.Decimal(18, 6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  session ScanSession    @relation(fields: [sessionId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([sessionId, variantId], map: "uq_scan_session_lines_session_variant")
  @@map("scan_session_lines")
}

// One row per physical scan. unique(session, scan_id) turns a double trigger pull into one scan.
model ScanSessionEvent {
  id          String   @id @default(uuid(7)) @db.Uuid
  sessionId   String   @map("session_id") @db.Uuid
  scanId      String   @map("scan_id")
  barcode     String
  variantId   String   @map("variant_id") @db.Uuid
  createdById String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  session   ScanSession    @relation(fields: [sessionId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])

  @@unique([sessionId, scanId], map: "uq_scan_session_events_session_scan")
  @@map("scan_session_events")
}

// ─── Stocktake ─────────────────────────────────────────────────────────────────────────────────

model Stocktake {
  id          String          @id @default(uuid(7)) @db.Uuid
  locationId  String          @map("location_id") @db.Uuid
  scope       StocktakeScope
  status      StocktakeStatus @default(DRAFT)
  note        String?
  snapshotAt  DateTime?       @map("snapshot_at") @db.Timestamptz(3)
  // Highest ledger seq included in the expected quantities. Movements at this location with a
  // higher seq happened after the snapshot, and review warns about them.
  snapshotSeq BigInt?         @map("snapshot_seq")
  createdById String          @map("created_by") @db.Uuid
  appliedById String?         @map("applied_by") @db.Uuid
  appliedAt   DateTime?       @map("applied_at") @db.Timestamptz(3)
  cancelledAt DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  location  Location @relation(fields: [locationId], references: [id])
  createdBy User     @relation("StocktakeCreatedBy", fields: [createdById], references: [id])
  appliedBy User?    @relation("StocktakeAppliedBy", fields: [appliedById], references: [id])

  lines  StocktakeLine[]
  events StocktakeScanEvent[]

  @@index([locationId, status], map: "idx_stocktakes_location_status")
  @@map("stocktakes")
}

model StocktakeLine {
  id               String   @id @default(uuid(7)) @db.Uuid
  stocktakeId      String   @map("stocktake_id") @db.Uuid
  variantId        String   @map("variant_id") @db.Uuid
  expectedQuantity Int      @default(0) @map("expected_quantity")
  // null = not counted yet. Review refuses to proceed while any line is null, unless the user
  // explicitly confirms uncounted lines as zero.
  countedQuantity  Int?     @map("counted_quantity")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  stocktake Stocktake      @relation(fields: [stocktakeId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([stocktakeId, variantId], map: "uq_stocktake_lines_stocktake_variant")
  @@map("stocktake_lines")
}

model StocktakeScanEvent {
  id          String   @id @default(uuid(7)) @db.Uuid
  stocktakeId String   @map("stocktake_id") @db.Uuid
  scanId      String   @map("scan_id")
  barcode     String
  variantId   String   @map("variant_id") @db.Uuid
  createdById String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  stocktake Stocktake      @relation(fields: [stocktakeId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])

  @@unique([stocktakeId, scanId], map: "uq_stocktake_scan_events_stocktake_scan")
  @@map("stocktake_scan_events")
}

// ─── Accounting (ADR-013) ──────────────────────────────────────────────────────────────────────
// Double entry in USD cents (the base). Entries and lines are append-only (trigger); every entry
// balances (deferred constraint trigger); nothing is dated inside a closed month (trigger).

// دليل الحسابات. Codes grow with depth (1 → 11 → 1101 → 110101); only postable accounts take
// lines. A cash account holds one currency. system_role names the accounts code posts to.
model GlAccount {
  id         String   @id @default(uuid(7)) @db.Uuid
  code       String   @unique(map: "uq_gl_accounts_code")
  nameAr     String   @map("name_ar")
  // 1 assets · 2 liabilities · 3 equity · 4 revenue · 5 expenses
  class      Int      @db.SmallInt
  parentId   String?  @map("parent_id") @db.Uuid
  isPostable Boolean  @default(true) @map("is_postable")
  currency   String?  @db.Char(3)
  // GENERAL · CASH (a cash box in one currency) · INVENTORY (posted only from stock movements)
  kind       String   @default("GENERAL")
  systemRole String?  @unique(map: "uq_gl_accounts_system_role") @map("system_role")
  locationId String?  @unique(map: "uq_gl_accounts_location_id") @map("location_id") @db.Uuid
  branch     String?  @db.Char(2)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent          GlAccount?       @relation("GlAccountTree", fields: [parentId], references: [id])
  children        GlAccount[]      @relation("GlAccountTree")
  location        Location?        @relation(fields: [locationId], references: [id])
  lines           JournalLine[]
  payrollPayments PayrollPayment[]

  @@index([parentId], map: "idx_gl_accounts_parent_id")
  @@map("gl_accounts")
}

// قيد يومية. One per voucher, or per stock movement (source_type/source_id, unique).
model JournalEntry {
  id          String   @id @default(uuid(7)) @db.Uuid
  voucherType String   @map("voucher_type")
  voucherYear Int      @map("voucher_year") @db.SmallInt
  voucherNo   Int      @map("voucher_no")
  entryDate   DateTime @map("entry_date") @db.Date
  memo        String?
  sourceType  String?  @map("source_type")
  sourceId    String?  @map("source_id")
  reversesId  String?  @unique(map: "uq_journal_entries_reverses_id") @map("reverses_id") @db.Uuid
  createdById String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  reverses         JournalEntry?      @relation("JournalReversal", fields: [reversesId], references: [id])
  reversedBy       JournalEntry?      @relation("JournalReversal")
  createdBy        User               @relation(fields: [createdById], references: [id])
  lines            JournalLine[]
  periods          AccountingPeriod[]
  posShifts        PosShift[]
  payrollAccruals  PayrollRun[]       @relation("PayrollRunAccrual")
  payrollReversals PayrollRun[]       @relation("PayrollRunReversal")
  payrollPayments  PayrollPayment[]
  employeeAdvances EmployeeAdvance[]
  partyEntries     PartyEntry[]

  @@unique([voucherType, voucherYear, voucherNo], map: "uq_journal_entries_voucher")
  @@unique([sourceType, sourceId], map: "uq_journal_entries_source")
  @@index([entryDate], map: "idx_journal_entries_entry_date")
  @@map("journal_entries")
}

// amountBase: USD cents, debit positive. amountCurrency: the same in the line's currency (minor
// units, same sign); rate: units of that currency per 1 USD.
model JournalLine {
  id             String  @id @default(uuid(7)) @db.Uuid
  entryId        String  @map("entry_id") @db.Uuid
  lineNo         Int     @map("line_no") @db.SmallInt
  accountId      String  @map("account_id") @db.Uuid
  amountBase     BigInt  @map("amount_base")
  currency       String  @db.Char(3)
  amountCurrency BigInt  @map("amount_currency")
  rate           Decimal @db.Decimal(18, 6)
  branch         String? @db.Char(2)
  locationId     String? @map("location_id") @db.Uuid
  memo           String?

  entry    JournalEntry @relation(fields: [entryId], references: [id])
  account  GlAccount    @relation(fields: [accountId], references: [id])
  location Location?    @relation(fields: [locationId], references: [id])

  @@unique([entryId, lineNo], map: "uq_journal_lines_entry_line")
  @@index([accountId], map: "idx_journal_lines_account_id")
  @@map("journal_lines")
}

// A closed month ("2026-10"): no entry may be dated on or before ends_on any more.
model AccountingPeriod {
  period             String   @id @db.Char(7)
  endsOn             DateTime @map("ends_on") @db.Date
  revaluationEntryId String?  @map("revaluation_entry_id") @db.Uuid
  closedById         String   @map("closed_by") @db.Uuid
  closedAt           DateTime @default(now()) @map("closed_at") @db.Timestamptz(3)

  revaluationEntry JournalEntry? @relation(fields: [revaluationEntryId], references: [id])
  closedBy         User          @relation(fields: [closedById], references: [id])

  @@map("accounting_periods")
}

model VoucherCounter {
  voucherType String @map("voucher_type")
  voucherYear Int    @map("voucher_year") @db.SmallInt
  lastNo      Int    @map("last_no")

  @@id([voucherType, voucherYear])
  @@map("voucher_counters")
}

model AccountingSyncState {
  name    String @id
  lastSeq BigInt @map("last_seq")

  @@map("accounting_sync_state")
}

// ─── Retail: the store's point of sale (ADR-014) ───────────────────────────────────────────────
// Prices and totals are SYP minor units. Sales, their lines and payments are append-only (trigger);
// a refund is a new receipt. At most one OPEN shift per location (partial unique index in SQL).

model PosShift {
  id             String    @id @default(uuid(7)) @db.Uuid
  locationId     String    @map("location_id") @db.Uuid
  // OPEN · CLOSED
  status         String    @default("OPEN")
  openedById     String    @map("opened_by") @db.Uuid
  openedAt       DateTime  @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedById     String?   @map("closed_by") @db.Uuid
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(3)
  journalEntryId String?   @map("journal_entry_id") @db.Uuid

  location     Location       @relation(fields: [locationId], references: [id])
  openedBy     User           @relation("PosShiftOpenedBy", fields: [openedById], references: [id])
  closedBy     User?          @relation("PosShiftClosedBy", fields: [closedById], references: [id])
  journalEntry JournalEntry?  @relation(fields: [journalEntryId], references: [id])
  cash         PosShiftCash[]
  sales        PosSale[]

  @@index([locationId, openedAt(sort: Desc)], map: "idx_pos_shifts_location_opened")
  @@map("pos_shifts")
}

// The drawer per currency (SYP, USD, TRY): at opening, and as counted at closing.
model PosShiftCash {
  shiftId  String  @map("shift_id") @db.Uuid
  currency String  @db.Char(3)
  opening  BigInt
  counted  BigInt?

  shift PosShift @relation(fields: [shiftId], references: [id])

  @@id([shiftId, currency])
  @@map("pos_shift_cash")
}

model PosSale {
  id            String   @id @default(uuid(7)) @db.Uuid
  // SALE · REFUND
  kind          String
  receiptYear   Int      @map("receipt_year") @db.SmallInt
  receiptNo     Int      @map("receipt_no")
  shiftId       String   @map("shift_id") @db.Uuid
  locationId    String   @map("location_id") @db.Uuid
  refundOfId    String?  @map("refund_of_id") @db.Uuid
  subtotal      BigInt
  discount      BigInt   @default(0)
  total         BigInt
  // The total in USD cents at the SYP rate of the moment.
  totalBase     BigInt   @map("total_base")
  // Change given back, in SYP.
  change        BigInt   @default(0)
  sypRate       Decimal  @map("syp_rate") @db.Decimal(18, 6)
  // A sale on account (ADR-016): the customer, and what they owe instead of paying.
  partyId       String?  @map("party_id") @db.Uuid
  onAccount     BigInt   @default(0) @map("on_account")
  onAccountBase BigInt   @default(0) @map("on_account_base")
  note          String?
  createdById   String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  shift     PosShift      @relation(fields: [shiftId], references: [id])
  location  Location      @relation(fields: [locationId], references: [id])
  refundOf  PosSale?      @relation("PosRefund", fields: [refundOfId], references: [id])
  refunds   PosSale[]     @relation("PosRefund")
  createdBy User          @relation(fields: [createdById], references: [id])
  lines     PosSaleLine[]
  payments  PosPayment[]

  party Party? @relation(fields: [partyId], references: [id])

  @@unique([kind, receiptYear, receiptNo], map: "uq_pos_sales_receipt")
  @@index([shiftId], map: "idx_pos_sales_shift_id")
  @@index([refundOfId], map: "idx_pos_sales_refund_of_id")
  @@map("pos_sales")
}

model PosSaleLine {
  saleId       String @map("sale_id") @db.Uuid
  lineNo       Int    @map("line_no") @db.SmallInt
  variantId    String @map("variant_id") @db.Uuid
  quantity     Int
  unitPrice    BigInt @map("unit_price")
  // After its share of the discount.
  netTotal     BigInt @map("net_total")
  refundOfLine Int?   @map("refund_of_line") @db.SmallInt
  // One piece's cost, USD cents, as the stock ledger valued it.
  unitCostBase BigInt @map("unit_cost_base")

  sale    PosSale        @relation(fields: [saleId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@id([saleId, lineNo])
  @@index([variantId], map: "idx_pos_sale_lines_variant_id")
  @@map("pos_sale_lines")
}

model PosPayment {
  saleId   String  @map("sale_id") @db.Uuid
  currency String  @db.Char(3)
  // Minor units handed over; negative when money goes back (a refund).
  amount   BigInt
  // Units of the currency per 1 USD; 1 for USD.
  rate     Decimal @db.Decimal(18, 6)
  base     BigInt

  sale PosSale @relation(fields: [saleId], references: [id])

  @@id([saleId, currency])
  @@map("pos_payments")
}

model PosCounter {
  kind   String
  year   Int    @db.SmallInt
  lastNo Int    @map("last_no")

  @@id([kind, year])
  @@map("pos_counters")
}

// ─── Payroll (ADR-015) ──────────────────────────────────────────────────────────────────────

model Employee {
  id        String   @id @default(uuid(7)) @db.Uuid
  nameAr    String   @map("name_ar")
  phone     String?
  jobTitle  String?  @map("job_title")
  // SY · LY
  branch    String   @default("SY") @db.Char(2)
  currency  String   @db.Char(3)
  // Per pay period, minor units of `currency`.
  salary    BigInt
  // MONTHLY · WEEKLY
  frequency String   @default("MONTHLY")
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  lines    PayrollLine[]
  advances EmployeeAdvance[]

  @@map("employees")
}

model PayrollRun {
  id              String    @id @default(uuid(7)) @db.Uuid
  // MONTHLY · WEEKLY
  frequency       String
  periodStart     DateTime  @map("period_start") @db.Date
  periodEnd       DateTime  @map("period_end") @db.Date
  // DRAFT · APPROVED · CANCELLED
  status          String    @default("DRAFT")
  accrualEntryId  String?   @map("accrual_entry_id") @db.Uuid
  reversalEntryId String?   @map("reversal_entry_id") @db.Uuid
  createdById     String    @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  approvedById    String?   @map("approved_by") @db.Uuid
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz(3)
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(3)

  accrualEntry  JournalEntry?    @relation("PayrollRunAccrual", fields: [accrualEntryId], references: [id])
  reversalEntry JournalEntry?    @relation("PayrollRunReversal", fields: [reversalEntryId], references: [id])
  createdBy     User             @relation("PayrollRunCreatedBy", fields: [createdById], references: [id])
  approvedBy    User?            @relation("PayrollRunApprovedBy", fields: [approvedById], references: [id])
  lines         PayrollLine[]
  payments      PayrollPayment[]

  @@index([periodStart(sort: Desc)], map: "idx_payroll_runs_period_start")
  @@map("payroll_runs")
}

model PayrollPayment {
  id             String   @id @default(uuid(7)) @db.Uuid
  runId          String   @map("run_id") @db.Uuid
  boxAccountId   String   @map("box_account_id") @db.Uuid
  currency       String   @db.Char(3)
  amount         BigInt
  journalEntryId String?  @map("journal_entry_id") @db.Uuid
  paidById       String   @map("paid_by") @db.Uuid
  paidAt         DateTime @default(now()) @map("paid_at") @db.Timestamptz(3)

  run          PayrollRun    @relation(fields: [runId], references: [id])
  box          GlAccount     @relation(fields: [boxAccountId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])
  paidBy       User          @relation(fields: [paidById], references: [id])
  lines        PayrollLine[]

  @@map("payroll_payments")
}

model PayrollLine {
  id            String  @id @default(uuid(7)) @db.Uuid
  runId         String  @map("run_id") @db.Uuid
  employeeId    String  @map("employee_id") @db.Uuid
  currency      String  @db.Char(3)
  branch        String  @db.Char(2)
  salary        BigInt
  bonus         BigInt  @default(0)
  deduction     BigInt  @default(0)
  deductionNote String? @map("deduction_note")
  advanceDeduct BigInt  @default(0) @map("advance_deduct")
  netBase       BigInt? @map("net_base")
  paymentId     String? @map("payment_id") @db.Uuid

  run      PayrollRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee          @relation(fields: [employeeId], references: [id])
  payment  PayrollPayment?   @relation(fields: [paymentId], references: [id])
  advances EmployeeAdvance[]

  @@unique([runId, employeeId], map: "uq_payroll_lines_run_employee")
  @@index([employeeId], map: "idx_payroll_lines_employee_id")
  @@map("payroll_lines")
}

model EmployeeAdvance {
  id             String   @id @default(uuid(7)) @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  // GIVEN · REPAID · DEDUCTED · RESTORED
  kind           String
  amount         BigInt
  amountBase     BigInt   @map("amount_base")
  journalEntryId String?  @map("journal_entry_id") @db.Uuid
  payrollLineId  String?  @map("payroll_line_id") @db.Uuid
  note           String?
  createdById    String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  employee     Employee      @relation(fields: [employeeId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])
  payrollLine  PayrollLine?  @relation(fields: [payrollLineId], references: [id])
  createdBy    User          @relation(fields: [createdById], references: [id])

  @@index([employeeId, createdAt], map: "idx_employee_advances_employee")
  @@map("employee_advances")
}

// ─── Suppliers and customers (ADR-016) ──────────────────────────────────────────────────────

model Party {
  id        String   @id @default(uuid(7)) @db.Uuid
  // SUPPLIER · CUSTOMER
  kind      String
  nameAr    String   @map("name_ar")
  phone     String?
  currency  String   @db.Char(3)
  branch    String   @default("SY") @db.Char(2)
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  entries  PartyEntry[]
  posSales PosSale[]

  @@index([kind, nameAr], map: "idx_parties_kind_name")
  @@map("parties")
}

model PartyEntry {
  id             String   @id @default(uuid(7)) @db.Uuid
  partyId        String   @map("party_id") @db.Uuid
  // BILL · PAYMENT · INVOICE · RECEIPT · POS_SALE · POS_REFUND
  kind           String
  // > 0: more outstanding; < 0: settled. Minor units of the party's currency.
  amount         BigInt
  amountBase     BigInt   @map("amount_base")
  sourceType     String   @map("source_type")
  sourceId       String   @map("source_id") @db.Uuid
  journalEntryId String?  @map("journal_entry_id") @db.Uuid
  note           String?
  createdById    String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  party        Party         @relation(fields: [partyId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])
  createdBy    User          @relation(fields: [createdById], references: [id])

  @@unique([kind, sourceId], map: "uq_party_entries_source")
  @@index([partyId, createdAt], map: "idx_party_entries_party")
  @@map("party_entries")
}
